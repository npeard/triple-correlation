 @article{Katz_2014, title={Non-invasive single-shot imaging through scattering layers and around corners via speckle correlations}, volume={8}, ISSN={1749-4885, 1749-4893}, DOI={10.1038/nphoton.2014.189}, number={10}, journal={Nature Photonics}, author={Katz, Ori and Heidmann, Pierre and Fink, Mathias and Gigan, Sylvain}, year={2014}, month={Oct}, pages={784–790}, language={en} }

 @article{Stern_2019, title={Non-invasive Focusing Through Scattering Layers Using Speckle-Correlations}, volume={44}, ISSN={0146-9592, 1539-4794}, DOI={10.1364/OL.44.000143}, abstractNote={Angular speckle correlations known as the “memory-effect” have recently been exploited for non-invasive imaging through scattering layers. Here, we show how the imaging information obtained from speckle correlations can be used as a noninvasive feedback mechanism for wavefront shaping. We utilize this feedback to demonstrate guide-star free noninvasive focusing of coherent light through highly scattering layers.}, note={arXiv: 1808.03267}, number={1}, journal={Optics Letters}, author={Stern, Galya and Katz, Ori}, year={2019}, month={Jan}, pages={143}, language={en} }

