 @article{Inoue_2019, title={Determination of X-ray pulse duration via intensity correlation measurements of X-ray fluorescence}, volume={26}, ISSN={1600-5775}, url={http://scripts.iucr.org/cgi-bin/paper?S1600577519011202}, DOI={10.1107/S1600577519011202}, abstractNote={A simple method using X-ray fluorescence is proposed to diagnose the duration of an X-ray free-electron laser (XFEL) pulse. This work shows that the degree of intensity correlation of the X-ray fluorescence generated by irradiating an XFEL pulse on metal foil reflects the magnitude relation between the XFEL duration and the coherence time of the fluorescence. Through intensity correlation measurements of copper Kα fluorescence, the duration of 12 keV XFEL pulses from SACLA was evaluated to be ∼10 fs.}, number={6}, journal={Journal of Synchrotron Radiation}, author={Inoue, Ichiro and Tamasaku, Kenji and Osaka, Taito and Inubushi, Yuichi and Yabashi, Makina}, year={2019}, month={Nov} }

