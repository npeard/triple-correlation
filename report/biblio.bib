 @article{Baldwin_1986, title={Closure phase in high-resolution optical imaging}, volume={320}, ISSN={0028-0836, 1476-4687}, DOI={10.1038/320595a0}, number={6063}, journal={Nature}, author={Baldwin, J. E. and Haniff, C. A. and Mackay, C. D. and Warner, P. J.}, year={1986}, month={Apr}, pages={595–597}, language={en} }
 
 @article{Holambe_1996, title={Signal phase recovery using the bispectrum}, volume={55}, ISSN={01651684}, DOI={10.1016/S0165-1684(96)00141-7}, abstractNote={In this paper, three simple algorithms for recovery of the phase of a discrete deterministic signal from its bispectrum have been proposed. The algorithms do not involve any phase unwrapping or any solution of a system of equations. Even though the discussion presented here is for deterministic signals, it has been shown that the algorithms can be used for estimation of the phase of linear stochastic processes as well.}, number={3}, journal={Signal Processing}, author={Holambe, R.S. and Ray, A.K. and Basu, T.K.}, year={1996}, month={Dec}, pages={321–337}, language={en} }
 
 @article{Lohmann_1983, title={Speckle masking in astronomy: triple correlation theory and applications}, volume={22}, ISSN={0003-6935, 1539-4522}, DOI={10.1364/AO.22.004028}, number={24}, journal={Applied Optics}, author={Lohmann, Adolf W. and Weigelt, Gerd and Wirnitzer, Bernhard}, year={1983}, month={Dec}, pages={4028}, language={en} }
 
 @article{Lohmann_1984, title={Triple Correlations}, volume={72}, number={7}, journal={Proceedings of the IEEE}, author={Lohmann, Adolf W. and Wirnitzer, Bernhard}, year={1984} }
 
 @article{Marathay_1994, title={Phase function of spatial coherence from second-, third-, and fourth- order intensity correlations}, volume={33}, ISSN={0091-3286}, DOI={10.1117/12.181252}, abstractNote={It is well known that the intensity interferometry of Hanbury Brown and Twiss measures the square of the absolute value of the normalized coherence function and that the phase of the function is lost. We show that the cosine and the sine of the phase can be determined using triple- and quadruple-intensity correlations. This information is used to derive the intensity distribution of the object. The procedure for the phase reconstruction described depends on the starting values of the phase function for the least separation of the mirrors or for the nearest neighbors in the two perpendicular directions of the array of mirrors. These starting values are determined by means of an amplitude correlation experiment, such as the Young’s two-slit type. The procedure of intensity correlations is then used for all other separations throughout the array. Computer simulation of the proposed procedure and a simple example of reconstruction of object intensity distribution are shown.}, number={10}, journal={Optical Engineering}, author={Marathay, Arvind S. and Hu, Yiping and Shao, Lianzhen}, year={1994}, month={Oct}, pages={3265}, language={en} }
 
 @article{Matsuoka_1984, title={Phase estimation using the bispectrum}, volume={72}, ISSN={0018-9219}, DOI={10.1109/PROC.1984.13027}, number={10}, journal={Proceedings of the IEEE}, author={Matsuoka, T. and Ulrych, T.J.}, year={1984}, pages={1403–1411}, language={en} }
 
 @article{Sayrol_1995, title={Image restoration using the W-slice method}, volume={4}, ISSN={10577149}, DOI={10.1109/83.403426}, number={8}, journal={IEEE Transactions on Image Processing}, author={Sayrol, E. and Nikias, C.L. and Gasull, A.}, year={1995}, month={Aug}, pages={1174–1181}, language={en} }
 
