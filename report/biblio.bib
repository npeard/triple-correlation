 @article{Feurer_1998, title={Measuring the temporal intensity of ultrashort laser pulses by triple correlation}, volume={66}, ISSN={0946-2171, 1432-0649}, DOI={10.1007/s003400050370}, abstractNote={By measuring the triple correlation of an ultrashort laser pulse, it is possible to determine the temporal envelope of the pulse intensity. No assumptions on the analytic form of the pulse shape and no iterative algorithms are necessary. The method is extremely stable even for noisy data, and is a powerful tool for pulses that have a strong amplitude modulation. A multi-shot and a single-shot arrangement of the triple correlator has been realized.}, number={2}, journal={Applied Physics B: Lasers and Optics}, author={Feurer, T. and Niedermeier, S. and Sauerbrey, R.}, year={1998}, month={Feb}, pages={163–168}, language={en} }

